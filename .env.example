# ==============================================================================
# AgriTrails Environment Configuration (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Base URL
# ------------------------------------------------------------------------------
# Base URL of the running application (used for absolute callback links and travel cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Postgres & Auth
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com/dashboard
# Obtain Project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Obtain service_role key from Project Settings > API (Keep secret! Used in API routes & AI tools)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Telegram Notifications & In-Telegram Approval
# ------------------------------------------------------------------------------
# Notification channel: 'telegram', 'whatsapp', or 'mock'
# Defaults to 'telegram' when TELEGRAM_BOT_TOKEN exists, otherwise 'mock'
NOTIFY_CHANNEL=telegram

# Telegram Bot Token from @BotFather (keep secret!)
TELEGRAM_BOT_TOKEN=

# Secret token verified in X-Telegram-Bot-Api-Secret-Token webhook header
TELEGRAM_WEBHOOK_SECRET=your-secure-webhook-secret

# Telegram Bot username without @ (e.g. AgriTrailsBot)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AgriTrailsBot

# One-time setWebhook command with secret_token parameter:
# curl -F "url=https://your-domain.com/api/telegram/webhook" -F "secret_token=YOUR_WEBHOOK_SECRET" https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook

# ------------------------------------------------------------------------------
# 4. WhatsApp Cloud API (Legacy / Optional)
# ------------------------------------------------------------------------------
# Meta System User Permanent Token with `whatsapp_business_messaging` permissions
WHATSAPP_TOKEN=

# WhatsApp Business Account Phone Number ID from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=

# Secret token used to protect /api/cron/reminders (Bearer auth or query ?secret=)
CRON_SECRET=your-secure-cron-secret-here

# NOTE: If TELEGRAM_BOT_TOKEN is omitted, AgriTrails runs in Mock Mode automatically:
# notification attempts are logged to the database with status 'mock' and shown
# in the UI Message Preview panel without failing bookings.

# ------------------------------------------------------------------------------
# 5. AgriGuide AI Assistant & RAG (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Primary conversational model with tool-calling support
GEMINI_MODEL=gemini-3.5-flash

# Fallback lightweight conversational model for 429/5xx retry or quota fallback
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Embeddings model for pgvector RAG indexing and hybrid search (768 dimensions)
GEMINI_EMBED_MODEL=gemini-embedding-001

# Enable deterministic mock stream mode without calling Gemini API (true / false)
CHAT_MOCK=false

# Daily chat message cap per IP / system (default: 5000)
CHAT_DAILY_LIMIT=5000

# Secret token used to protect /api/rag/reindex route (Bearer auth or query ?secret=)
RAG_REINDEX_SECRET=your-secure-rag-reindex-secret
