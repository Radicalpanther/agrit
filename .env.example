# ==============================================================================
# AgriTrails Environment Configuration (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Base URL
# ------------------------------------------------------------------------------
# Base URL of the running application (used for absolute callback links and travel cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Postgres & Auth
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com/dashboard
# Obtain Project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Obtain service_role key from Project Settings > API (Keep secret! Used in API routes & AI tools)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
# Meta System User Permanent Token with `whatsapp_business_messaging` permissions
WHATSAPP_TOKEN=

# WhatsApp Business Account Phone Number ID from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=

# Secret token used to protect /api/cron/reminders (Bearer auth or query ?secret=)
CRON_SECRET=your-secure-cron-secret-here

# NOTE: If WHATSAPP_TOKEN or WHATSAPP_PHONE_NUMBER_ID are omitted, AgriTrails runs
# in Mock Mode automatically: notification attempts are logged to the database
# with status 'mock' and shown in the UI Message Preview panel without failing bookings.

# ------------------------------------------------------------------------------
# 4. AgriGuide AI Assistant (Claude or Gemini)
# ------------------------------------------------------------------------------
# Provider priority:
# 1. ANTHROPIC_API_KEY (Claude 3.5 Sonnet)
# 2. GEMINI_API_KEY (Google Gemini free tier)
# 3. If neither is provided, AgriGuide uses the built-in database-driven mock stream,
#    which queries real database tools and returns authentic farm and crop data.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
